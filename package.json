{
  "name": "wordcaptor",
  "version": "0.1.0",
  "description": "一位帮你读英文网页和 YouTube 的小魔法使：只译正文，接你自己的模型。",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@chinese-fonts/xiaolai": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
